	"loading-progress-styles": {"type": "css", "value": {"background": "rgba(255, 255, 255, 0.2)", "left:portrait": "34%", "right:portrait": "34%", "top:portrait": "85%", "bottom:portrait": "5%", "left:landscape": "40%", "right:landscape": "40%", "top:landscape": "85%", "bottom:landscape": "10%", "filter": "drop-shadow(0px 0px 3px #00000022)"}},
