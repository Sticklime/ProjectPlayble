{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config.schema.json",
  "title": "Схема конфигурации сжатия изображений",
  "description": "Схема для настройки параметров сжатия изображений различных форматов",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Ссылка на JSON схему для валидации"
    },
    "_comment": {
      "type": "string",
      "description": "Необязательный комментарий, описывающий назначение этого конфигурационного файла"
    },
    "_description": {
      "type": "array",
      "description": "Необязательный массив строк с подробным описанием конфигурации",
      "items": {
        "type": "string"
      }
    },
    "default": {
      "type": "object",
      "description": "Настройки сжатия по умолчанию, применяемые ко всем изображениям",
      "properties": {
        "maxSize": {
          "type": "object",
          "description": "Настройки максимального размера изображения",
          "properties": {
            "width": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 16384,
              "description": "Максимальная ширина изображения в пикселях (null = без ограничений)"
            },
            "height": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 16384,
              "description": "Максимальная высота изображения в пикселях (null = без ограничений)"
            },
            "fit": {
              "type": "string",
              "enum": ["cover", "contain", "fill", "inside", "outside"],
              "default": "inside",
              "description": "Метод подгонки изображения при изменении размера"
            },
            "withoutEnlargement": {
              "type": "boolean",
              "default": true,
              "description": "Не увеличивать изображения меньшего размера"
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "description": "Настройки качества сжатия для разных типов изображений",
          "properties": {
            "opaque": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Качество сжатия для непрозрачных изображений (1-100, выше = лучше качество)"
            },
            "transparent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Качество сжатия для изображений с прозрачностью (1-100, выше = лучше качество)"
            }
          },
          "required": ["opaque", "transparent"],
          "additionalProperties": false
        },
        "outputFormat": {
          "type": "object",
          "description": "Настройки выходного формата для разных типов изображений",
          "properties": {
            "opaque": {
              "type": "string",
              "enum": ["jpg", "jpeg", "webp", "none"],
              "description": "Выходной формат для непрозрачных изображений (none = оставить исходный формат)"
            },
            "transparent": {
              "type": "string",
              "enum": ["png", "webp", "none"],
              "description": "Выходной формат для изображений с прозрачностью (none = оставить исходный формат)"
            }
          },
          "required": ["opaque", "transparent"],
          "additionalProperties": false
        },
        "formatOptions": {
          "type": "object",
          "description": "Продвинутые настройки для каждого формата изображений",
          "properties": {
            "webp": {
              "type": "object",
              "description": "Настройки для формата WebP",
              "properties": {
                "quality": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100,
                  "description": "Качество WebP (1-100)"
                },
                "lossless": {
                  "type": "boolean",
                  "description": "Использовать lossless сжатие"
                },
                "nearLossless": {
                  "type": "boolean",
                  "description": "Использовать near-lossless сжатие"
                },
                "smartSubsample": {
                  "type": "boolean",
                  "description": "Использовать интеллектуальную цветовую подвыборку"
                },
                "effort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "Уровень усилий CPU (0-6, больше = медленнее, но лучше)"
                },
                "alphaQuality": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Качество альфа-канала (0-100)"
                },
                "minSize": {
                  "type": "boolean",
                  "description": "Минимизировать размер файла"
                },
                "mixed": {
                  "type": "boolean",
                  "description": "Разрешить смешанное сжатие (lossy + lossless)"
                }
              },
              "additionalProperties": false
            },
            "jpeg": {
              "type": "object",
              "description": "Настройки для формата JPEG",
              "properties": {
                "quality": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100,
                  "description": "Качество JPEG (1-100)"
                },
                "mozjpeg": {
                  "type": "boolean",
                  "description": "Использовать MozJPEG оптимизацию"
                },
                "progressive": {
                  "type": "boolean",
                  "description": "Создать прогрессивный JPEG"
                },
                "optimizeCoding": {
                  "type": "boolean",
                  "description": "Оптимизировать Huffman таблицы"
                },
                "trellisQuantisation": {
                  "type": "boolean",
                  "description": "Применить trellis квантование (требует mozjpeg)"
                },
                "overshootDeringing": {
                  "type": "boolean",
                  "description": "Применить overshoot deringing (требует mozjpeg)"
                },
                "chromaSubsampling": {
                  "type": "string",
                  "enum": ["4:4:4", "4:2:0"],
                  "description": "Режим цветовой подвыборки"
                }
              },
              "additionalProperties": false
            },
            "png": {
              "type": "object",
              "description": "Настройки для формата PNG",
              "properties": {
                "compressionLevel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9,
                  "description": "Уровень сжатия zlib (0-9)"
                },
                "progressive": {
                  "type": "boolean",
                  "description": "Использовать прогрессивное (interlaced) сжатие"
                },
                "palette": {
                  "type": "boolean",
                  "description": "Включить палитровый режим (PNG8)"
                },
                "quality": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Качество для палитрового режима (0-100)"
                },
                "effort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10,
                  "description": "Уровень усилий CPU (1-10)"
                },
                "colors": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 256,
                  "description": "Максимальное количество цветов в палитре"
                },
                "dither": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Уровень дизеринга для палитрового режима (0-1)"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["quality", "outputFormat"],
      "additionalProperties": false
    },
    "custom": {
      "type": "object",
      "description": "Пользовательские настройки сжатия для конкретных изображений (ключ = имя файла изображения без расширения)",
      "patternProperties": {
        "^[^/\\\\]+$": {
          "type": "object",
          "description": "Настройки сжатия для конкретного изображения (переопределяют настройки по умолчанию)",
          "properties": {
            "maxSize": {
              "type": "object",
              "description": "Настройки максимального размера для данного изображения",
              "properties": {
                "width": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 16384,
                  "description": "Максимальная ширина изображения в пикселях"
                },
                "height": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 16384,
                  "description": "Максимальная высота изображения в пикселях"
                },
                "fit": {
                  "type": "string",
                  "enum": ["cover", "contain", "fill", "inside", "outside"],
                  "description": "Метод подгонки изображения при изменении размера"
                },
                "withoutEnlargement": {
                  "type": "boolean",
                  "description": "Не увеличивать изображения меньшего размера"
                }
              },
              "additionalProperties": false
            },
            "quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Качество сжатия для данного изображения (применяется к обоим типам - прозрачным и непрозрачным)"
            },
            "outputFormat": {
              "type": "string",
              "enum": ["jpg", "jpeg", "png", "webp", "none"],
              "description": "Выходной формат для данного изображения (переопределяет формат для всех типов изображений, none = оставить исходный формат)"
            },
            "formatOptions": {
              "type": "object",
              "description": "Продвинутые настройки форматов для данного изображения",
              "properties": {
                "webp": {
                  "type": "object",
                  "description": "Настройки для формата WebP",
                  "properties": {
                    "quality": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "lossless": { "type": "boolean" },
                    "nearLossless": { "type": "boolean" },
                    "smartSubsample": { "type": "boolean" },
                    "effort": { "type": "integer", "minimum": 0, "maximum": 6 },
                    "alphaQuality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "minSize": { "type": "boolean" },
                    "mixed": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "jpeg": {
                  "type": "object",
                  "description": "Настройки для формата JPEG",
                  "properties": {
                    "quality": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "mozjpeg": { "type": "boolean" },
                    "progressive": { "type": "boolean" },
                    "optimizeCoding": { "type": "boolean" },
                    "trellisQuantisation": { "type": "boolean" },
                    "overshootDeringing": { "type": "boolean" },
                    "chromaSubsampling": {
                      "type": "string",
                      "enum": ["4:4:4", "4:2:0"]
                    }
                  },
                  "additionalProperties": false
                },
                "png": {
                  "type": "object",
                  "description": "Настройки для формата PNG",
                  "properties": {
                    "compressionLevel": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9
                    },
                    "progressive": { "type": "boolean" },
                    "palette": { "type": "boolean" },
                    "quality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "effort": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "colors": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 256
                    },
                    "dither": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["default"],
  "additionalProperties": false
}
